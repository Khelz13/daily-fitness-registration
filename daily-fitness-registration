<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Fitness Dashboard</title>
<style>
*{box-sizing:border-box}
:root{
  --yellow:#facc15;
  --yellow2:#eab308;
  --black:#070707;
  --panel:#111111;
  --panel2:#171717;
  --line:#292929;
  --muted:#a3a3a3;
  --white:#f8fafc;
  --danger:#ef4444;
  --green:#22c55e;
}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--black);color:var(--white)}
.header{
  background:linear-gradient(135deg,#050505,#151515);
  border-bottom:1px solid var(--line);
  padding:26px 34px;
  position:relative;
  overflow:hidden;
}
.header:after{
  content:"";
  position:absolute;right:-80px;top:-130px;width:420px;height:420px;
  border:70px solid rgba(250,204,21,.07);border-radius:50%;
}
.header-inner{max-width:1550px;margin:auto;position:relative;z-index:1}
.brand{display:flex;align-items:center;gap:14px}
.logo{
  width:52px;height:52px;border-radius:14px;background:var(--yellow);color:#050505;
  display:flex;align-items:center;justify-content:center;font-size:27px;font-weight:900;
  box-shadow:0 0 28px rgba(250,204,21,.2)
}
h1{margin:0;font-size:30px;letter-spacing:.5px}
.tag{margin:5px 0 0;color:var(--muted);font-size:13px;letter-spacing:2px;text-transform:uppercase}
.header-right{position:absolute;right:0;top:4px;text-align:right}
.live{color:var(--yellow);font-weight:800;font-size:13px;letter-spacing:1px}
.date{color:#777;font-size:12px;margin-top:5px}

.container{max-width:1550px;margin:auto;padding:30px 34px 60px}
.hero{
  display:flex;justify-content:space-between;align-items:center;gap:20px;
  margin-bottom:28px
}
.hero h2{font-size:34px;margin:0 0 7px}
.hero p{margin:0;color:var(--muted)}
.cta-row{display:flex;gap:12px;flex-wrap:wrap}
.btn{
  border:1px solid var(--line);background:var(--panel2);color:white;
  padding:13px 18px;border-radius:10px;font-weight:800;cursor:pointer
}
.btn:hover{border-color:#555}
.btn.primary{background:var(--yellow);color:#050505;border-color:var(--yellow)}
.btn.primary:hover{background:var(--yellow2)}
.btn.dark{background:#0d0d0d}

.status{
  background:#0d0d0d;border:1px solid #303030;color:#bdbdbd;
  padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:24px
}
.status b{color:var(--yellow)}

.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.card{
  background:linear-gradient(145deg,#141414,#0d0d0d);
  border:1px solid var(--line);border-radius:16px;padding:22px;
  min-height:165px;position:relative;overflow:hidden
}
.card:before{content:"";position:absolute;left:0;top:0;width:100%;height:3px;background:var(--yellow);opacity:.8}
.card-top{display:flex;justify-content:space-between;align-items:center}
.card h3{margin:0;color:#bdbdbd;font-size:14px;text-transform:uppercase;letter-spacing:1px}
.icon{
  width:42px;height:42px;border-radius:11px;background:#1e1e1e;
  display:flex;align-items:center;justify-content:center;font-size:21px
}
.card p{font-size:34px;font-weight:900;margin:24px 0 6px;color:#fff}
.card-sub{color:#737373;font-size:12px}
.yellow{color:var(--yellow)!important}

.section-title{
  margin:34px 0 16px;font-size:19px;text-transform:uppercase;letter-spacing:1.5px
}
.actions{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.action{
  background:#121212;border:1px solid var(--line);border-radius:13px;padding:18px;
  cursor:pointer;text-align:left;color:white;transition:.15s
}
.action:hover{transform:translateY(-2px);border-color:#555;background:#171717}
.action .emoji{font-size:24px;margin-bottom:12px}
.action strong{display:block;font-size:15px}
.action span{display:block;color:#777;font-size:11px;margin-top:5px}

.grid2{display:grid;grid-template-columns:1.25fr .75fr;gap:18px;margin-top:18px}
.panel{
  background:#111;border:1px solid var(--line);border-radius:16px;padding:22px
}
.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.panel h3{margin:0;font-size:17px}
.panel small{color:#777}
.stat-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:14px 0;border-bottom:1px solid #222
}
.stat-row:last-child{border-bottom:0}
.stat-row span:first-child{color:#999}
.stat-value{font-size:20px;font-weight:900;color:var(--yellow)}
.progress{height:8px;background:#242424;border-radius:20px;overflow:hidden;margin-top:12px}
.progress > div{height:100%;background:var(--yellow);border-radius:20px;width:0%}

.expiring-list{display:flex;flex-direction:column;gap:9px}
.expiring-item{
  display:flex;justify-content:space-between;align-items:center;
  padding:12px 14px;border-radius:10px;background:#171717;border:1px solid #242424
}
.expiring-name{font-weight:800}
.expiring-date{color:#777;font-size:11px;margin-top:3px}
.days{color:var(--yellow);font-weight:900;font-size:12px}
.empty{color:#666;text-align:center;padding:20px}

.footer-note{margin-top:24px;color:#555;font-size:11px;text-align:center}

@media(max-width:1300px){
  .cards{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:1100px){
  .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
  .actions{grid-template-columns:repeat(3,1fr)}
  .grid2{grid-template-columns:1fr}
}
@media(max-width:700px){
  .container{padding:22px 16px}
  .header{padding:22px 16px}
  .header-right{display:none}
  .hero{align-items:flex-start;flex-direction:column}
  .hero h2{font-size:28px}
  .cards{grid-template-columns:1fr}
  .actions{grid-template-columns:1fr 1fr}
  .card{min-height:145px}
  .card p{font-size:30px}
}
</style>
</head>
<body>

<header class="header">
  <div class="header-inner">
    <div class="brand">
      <div class="logo">🏋️</div>
      <div>
        <h1>DAILY FITNESS</h1>
