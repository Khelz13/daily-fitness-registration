<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
const firebaseConfig={
  apiKey:"AIzaSyDGIZ2hwqFbhEF40nhC-TxePj0rNBtDMA",
  authDomain:"daily-fitness-8f4bb.firebaseapp.com",
  databaseURL:"https://daily-fitness-8f4bb-default-rtdb.firebaseio.com",
  projectId:"daily-fitness-8f4bb",
  storageBucket:"daily-fitness-8f4bb.firebasestorage.app",
  messagingSenderId:"27440670515",
  appId:"1:27440670515:web:7292f1ee2573a25fc18046",
  measurementId:"G-SBQXSXIDML1"
};
firebase.initializeApp(firebaseConfig);
const db=firebase.database();
document.getElementById("firebaseStatus").innerHTML="☁️ <b>Firebase Connected</b> — Waiting for live dashboard data.";
function showReadError(error){console.error("Dashboard Firebase read error:",error);document.getElementById("firebaseStatus").innerHTML="⚠️ <b>Dashboard data could not load</b> — "+escapeHtml(error?.message||"Check Firebase Database access and the API key.");}

let members=[],payments=[],attendance=[],registrations=[];

function today(){
  const d=new Date();
  return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
}
function money(v){return "₱"+Number(v||0).toLocaleString("en-PH",{minimumFractionDigits:2,maximumFractionDigits:2});}
function escapeHtml(v){
  return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
}
function daysLeft(date){
  if(!date || !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(date))) return NaN;
  const [year,month,day]=String(date).split("-").map(Number);
  const a=new Date();
  a.setHours(0,0,0,0);
  const b=new Date(year,month-1,day);
  b.setHours(0,0,0,0);
  return Math.round((b-a)/86400000);
}
function refresh(){
  const t=today();
  document.getElementById("headerDate").textContent=new Date().toLocaleDateString("en-PH",{weekday:"long",year:"numeric",month:"long",day:"numeric"});
  document.getElementById("moneyDate").textContent=t;

  const todaysPayments=payments.filter(p=>p.paymentDate===t || p.date===t);
  const todaysAttendance=attendance.filter(a=>a.date===t);

  const membershipSales=todaysPayments.reduce((s,p)=>s+Number(p.amount||0),0);
  const attendanceSales=todaysAttendance.reduce((s,a)=>s+Number(a.total||0),0);
  const total=membershipSales+attendanceSales;

  const datedMembers=members.filter(m=>Number.isFinite(daysLeft(m.expiryDate)));
  const active=datedMembers.filter(m=>daysLeft(m.expiryDate)>=0);
  const expired=datedMembers.filter(m=>daysLeft(m.expiryDate)<0);
  const expiring=active.filter(m=>daysLeft(m.expiryDate)<=7);

  document.getElementById("totalMembers").textContent=members.length;
  document.getElementById("expiredMembers").textContent=expired.length;
  document.getElementById("todaySales").textContent=money(total);
  document.getElementById("todayAttendance").textContent=todaysAttendance.length;
  document.getElementById("activeMembers").textContent=active.length;
  const pending=registrations.filter(r=>String(r.status||"").toLowerCase()==="pending").length;

  document.getElementById("expiringSoon").textContent=expiring.length;
  document.getElementById("pendingRegistrations").textContent=pending;
  document.getElementById("pendingActionCount").textContent="("+pending+")";

  document.getElementById("moneyTotal").textContent=money(total);
  document.getElementById("moneyMembership").textContent=money(membershipSales);
  document.getElementById("moneyWalkin").textContent=money(attendanceSales);
  document.getElementById("statusActive").textContent=active.length;
  document.getElementById("statusExpired").textContent=expired.length;
  document.getElementById("statusExpiring").textContent=expiring.length;

  const target=10000;
  document.getElementById("salesProgress").style.width=Math.min(100,(total/target)*100)+"%";

  const list=document.getElementById("expiringList");
  if(!expiring.length){
    list.innerHTML='<div class="empty">🎉 No members expiring within 7 days.</div>';
  }else{
    list.innerHTML=expiring
      .sort((a,b)=>daysLeft(a.expiryDate)-daysLeft(b.expiryDate))
      .slice(0,10)
      .map(m=>{
        const d=daysLeft(m.expiryDate);
        return `<div class="expiring-item">
          <div><div class="expiring-name">${escapeHtml(m.name)}</div><div class="expiring-date">Expires ${escapeHtml(m.expiryDate||"-")}</div></div>
          <div class="days">${d===0?"TODAY":d+" DAYS"}</div>
        </div>`;
      }).join("");
  }
}

db.ref("members").on("value",snap=>{
  const data=snap.val()||{};
  members=Object.keys(data).map(k=>({...data[k],id:data[k]?.id??k}));
  refresh();
  document.getElementById("firebaseStatus").innerHTML="☁️ <b>Firebase Connected</b> — Live dashboard data loaded.";
},showReadError);
db.ref("payments").on("value",snap=>{
  const data=snap.val()||{};
  payments=Object.keys(data).map(k=>({...data[k],id:data[k]?.id??k}));
  refresh();
},showReadError);
db.ref("attendance").on("value",snap=>{
  const data=snap.val()||{};
  attendance=Object.keys(data).map(k=>({...data[k],id:data[k]?.id??k}));
  refresh();
},showReadError);
db.ref("registrationRequests").on("value",snap=>{
  const data=snap.val()||{};
  registrations=Object.keys(data).map(k=>({...data[k],id:data[k]?.id??k}));
  refresh();
},showReadError);
refresh();
</script>
</body>
</html>
