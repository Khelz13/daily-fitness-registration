    </div>
    <div class="cta-row">
      <button class="btn primary" onclick="location.href='members.html'">＋ NEW MONTHLY MEMBER</button>
      <button class="btn" onclick="location.href='pending_registrations.html'">📋 PENDING REGISTRATIONS</button>
    </div>
  </section>

  <div class="status" id="firebaseStatus">☁️ <b>Connecting to Firebase...</b> — Loading dashboard data.</div>

  <section class="cards">
    <div class="card">
      <div class="card-top"><h3>Total Members</h3><div class="icon">👥</div></div>
      <p id="totalMembers">0</p>
      <div class="card-sub">All registered monthly members</div>
    </div>
    <div class="card">
      <div class="card-top"><h3>Pending Registrations</h3><div class="icon">📝</div></div>
      <p id="pendingRegistrations" class="yellow">0</p>
      <div class="card-sub">New monthly applications waiting for approval</div>
    </div>
    <div class="card">
      <div class="card-top"><h3>Today's Sales</h3><div class="icon">💰</div></div>
      <p id="todaySales">₱0.00</p>
      <div class="card-sub">Membership + attendance + supplements</div>
    </div>
    <div class="card">
      <div class="card-top"><h3>Today's Attendance</h3><div class="icon">🕐</div></div>
      <p id="todayAttendance">0</p>
      <div class="card-sub">Gym visits today</div>
    </div>
    <div class="card">
      <div class="card-top"><h3>Active Members</h3><div class="icon">👥</div></div>
      <p id="activeMembers">0</p>
      <div class="card-sub">Current monthly members</div>
    </div>
    <div class="card">
      <div class="card-top"><h3>Expiring Soon</h3><div class="icon">⏰</div></div>
      <p id="expiringSoon">0</p>
      <div class="card-sub">Memberships expiring within 7 days</div>
    </div>
    <div class="card">
      <div class="card-top"><h3>Expired Members</h3><div class="icon">⚠️</div></div>
      <p id="expiredMembers">0</p>
      <div class="card-sub">Memberships past their expiry date</div>
    </div>
  </section>

  <h2 class="section-title">Quick Actions</h2>
  <section class="actions">
    <button class="action" onclick="location.href='members.html'"><div class="emoji">👥</div><strong>Monthly Members</strong><span>Manage active members</span></button>
    <button class="action" onclick="location.href='attendance_firebase.html'"><div class="emoji">🕐</div><strong>Attendance</strong><span>Record today's visits</span></button>
