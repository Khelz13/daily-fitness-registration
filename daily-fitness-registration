<script>
/* =========================================================
   DAILY FITNESS — MEMBERS / FIREBASE VERSION
   Firebase Realtime Database is now the main source of truth.
   LocalStorage is kept as a compatibility cache for existing
   pages until the rest of the system is migrated.
   ========================================================= */

const firebaseConfig = {
    apiKey: "AIzaSyDGI2ZhwFbhEF40nhC-TxePjP0rNBtDMA",
    authDomain: "daily-fitness-8f4bb.firebaseapp.com",
    databaseURL: "https://daily-fitness-8f4bb-default-rtdb.firebaseio.com",
    projectId: "daily-fitness-8f4bb",
    storageBucket: "daily-fitness-8f4bb.firebasestorage.app",
    messagingSenderId: "27440670515",
    appId: "1:27440670515:web:7292f1ee2573a25fc18046",
    measurementId: "G-SBQXSXIDML1"
};

if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
}

const db = firebase.database();
const membersRef = db.ref("members");

let editingMemberId = null;
let firebaseMembers = [];
let firebaseReady = false;

/* ---------------------------------------------------------
   SESSION / ROLE
--------------------------------------------------------- */
function getSession() {
    const keys = ["dailyFitnessSession"];

    for (const storage of [sessionStorage, localStorage]) {
        for (const key of keys) {
            try {
                const value = JSON.parse(storage.getItem(key) || "null");
                if (value) return value;
            } catch (e) {}
        }
    }

    return null;
}

const currentUser = getSession();

function getRole() {
    return String((currentUser && currentUser.role) || "").toLowerCase();
}

function isAdmin() {
    return getRole() === "admin";
}

function isStaff() {
    return getRole() === "staff";
}

function canManageMembers() {
    /*
       During this migration stage, allow the page to work even if
       the old local session is absent. Final Firebase Auth rules will
       become the real security layer later.
    */
    return true;
}

function updateRoleBanner() {
    const banner = document.getElementById("roleBanner");
    if (!banner) return;

    if (isAdmin()) {
        banner.className = "role-banner role-admin";
        banner.innerHTML = "👑 ADMIN MODE — Full member management access";
    } else if (isStaff()) {
        banner.className = "role-banner role-staff";
        banner.innerHTML = "👤 STAFF MODE — You can register and edit members. Delete is Admin-only.";
    } else {
        banner.className = "role-banner role-staff";
        banner.innerHTML = "☁️ FIREBASE MODE — Members are now shared through the cloud database.";
    }
}

/* ---------------------------------------------------------
   DATE HELPERS
--------------------------------------------------------- */
function formatDateLocal(date) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const d = String(date.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
}

function addOneMonth(dateString) {
    const parts = String(dateString).split("-").map(Number);
    if (parts.length !== 3 || parts.some(Number.isNaN)) return "";

    const year = parts[0];
    const month = parts[1] - 1;
    const day = parts[2];

    const date = new Date(year, month, day);
    date.setMonth(date.getMonth() + 1);
    return formatDateLocal(date);
}

function setStartDate() {
    const input = document.getElementById("startDate");
    if (!input) return;
    input.value = formatDateLocal(new Date());
}

/* ---------------------------------------------------------
   LOCAL STORAGE COMPATIBILITY
--------------------------------------------------------- */
function getLocalMembers() {
    try {
        return JSON.parse(localStorage.getItem("dailyFitnessMembers") || "[]") || [];
    } catch (e) {
        return [];
    }
}

function saveLocalMembers(members) {
    localStorage.setItem("dailyFitnessMembers", JSON.stringify(members));
}

function syncFirebaseToLocal(members) {
    saveLocalMembers(members);
}

/* ---------------------------------------------------------
   ONE-TIME MIGRATION OF EXISTING LOCAL MEMBERS
--------------------------------------------------------- */
async function migrateLocalMembersToFirebase(existingFirebaseMembers) {
    const localMembers = getLocalMembers();
    if (!localMembers.length) return;

    const firebaseById = new Map(
        existingFirebaseMembers.map(member => [String(member.id), member])
    );

    const updates = {};
    let added = 0;

    localMembers.forEach(member => {
        if (!member || member.id === undefined || member.id === null) return;

        const key = String(member.id);

        if (!firebaseById.has(key)) {
            updates[key] = {
                id: member.id,
                name: member.name || "",
                contact: member.contact || "",
                startDate: member.startDate || "",
                expiryDate: member.expiryDate || addOneMonth(member.startDate),
                fee: Number(member.fee) || 600,
                createdAt: member.createdAt || firebase.database.ServerValue.TIMESTAMP
            };
            added++;
        }
    });

    if (added > 0) {
        await membersRef.update(updates);
    }
}

/* ---------------------------------------------------------
   SAVE MEMBER
--------------------------------------------------------- */
async function saveMember() {
    if (!canManageMembers()) return;

    const name = document.getElementById("memberName").value.trim();
    const contact = document.getElementById("memberContact").value.trim();
    const startDate = document.getElementById("startDate").value;
    const fee = Number(document.getElementById("memberFee").value);

    if (!name) {
        alert("Please enter member name.");
        return;
    }

    if (!startDate) {
        alert("Please select start date.");
        return;
    }

    if (!fee || fee <= 0) {
        alert("Please enter a valid monthly fee.");
        return;
    }

    const id = Date.now();
    const member = {
        id,
        name,
        contact,
        startDate,
        expiryDate: addOneMonth(startDate),
        fee,
        createdAt: firebase.database.ServerValue.TIMESTAMP
    };

    try {
        await membersRef.child(String(id)).set(member);

        document.getElementById("memberName").value = "";
        document.getElementById("memberContact").value = "";
        document.getElementById("memberFee").value = "600";

        alert("Member registered successfully! ☁️");
    } catch (error) {
        console.error(error);
        alert("Unable to save member to Firebase.\n\n" + error.message);
    }
}

/* ---------------------------------------------------------
   DISPLAY MEMBERS
--------------------------------------------------------- */
function displayMembers() {
    const table = document.getElementById("membersTableBody");
    if (!table) return;

    const searchInput = document.getElementById("memberSearch");
    const search = (searchInput ? searchInput.value : "").trim().toLowerCase();

    table.innerHTML = "";

    const filteredMembers = firebaseMembers.filter(member => {
        const name = String(member.name || "").toLowerCase();
        const contact = String(member.contact || "").toLowerCase();
        return name.includes(search) || contact.includes(search);
    });

    if (!filteredMembers.length) {
        table.innerHTML = `
            <tr>
                <td colspan="8" class="no-results">
                    ${firebaseReady ? "No members found." : "Loading members from Firebase..."}
                </td>
            </tr>
        `;
        return;
    }

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    filteredMembers.forEach(member => {
        const expiryDate = new Date(member.expiryDate);
        expiryDate.setHours(0, 0, 0, 0);

        const difference = expiryDate - today;
        const daysLeft = Math.ceil(difference / (1000 * 60 * 60 * 24));

        let status = "Active";
        let statusClass = "status-active";
        let daysText = daysLeft + " days";

        if (daysLeft < 0) {
            status = "Expired";
            statusClass = "status-expired";
            daysText = Math.abs(daysLeft) + " days ago";
        } else if (daysLeft === 0) {
            status = "Active";
            daysText = "Expires today";
        }

        const row = document.createElement("tr");
        const safeId = String(member.id);

        row.innerHTML = `
            <td>${escapeHtml(member.name)}</td>
            <td>${escapeHtml(member.contact || "-")}</td>
            <td>${escapeHtml(member.startDate || "-")}</td>
            <td>${escapeHtml(member.expiryDate || "-")}</td>
            <td class="days-left">${daysText}</td>
            <td>₱${Number(member.fee || 0).toLocaleString("en-PH", {minimumFractionDigits: 2})}</td>
            <td class="${statusClass}">${status}</td>
            <td>
                <button class="view-btn" onclick="viewMember('${escapeJs(safeId)}')">👁️ View</button>
                <button class="edit-btn" onclick="editMember('${escapeJs(safeId)}')">✏️ Edit</button>
                ${isAdmin() ? `<button class="delete-btn" onclick="deleteMember('${escapeJs(safeId)}')">Delete</button>` : `<span style="color:#64748b;font-weight:700;font-size:13px;">🔒 Admin Delete</span>`}
            </td>
        `;

        table.appendChild(row);
    });
}

function escapeHtml(value) {
    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

function escapeJs(value) {
    return String(value ?? "").replace(/\\/g, "\\\\").replace(/'/g, "\\'");
}

/* ---------------------------------------------------------
   VIEW MEMBER
--------------------------------------------------------- */
function viewMember(id) {
    window.location.href = "member-profile_firebase.html?id=" + encodeURIComponent(id);
}

/* ---------------------------------------------------------
   EDIT MEMBER
--------------------------------------------------------- */
function editMember(id) {
    const member = firebaseMembers.find(item => String(item.id) === String(id));

    if (!member) {
        alert("Member not found.");
        return;
    }

    editingMemberId = String(id);

    document.getElementById("editName").value = member.name || "";
    document.getElementById("editContact").value = member.contact || "";
    document.getElementById("editStartDate").value = member.startDate || "";
    document.getElementById("editFee").value = Number(member.fee) || 600;
    document.getElementById("editBox").style.display = "block";

    document.getElementById("editBox").scrollIntoView({behavior:"smooth"});
}

/* ---------------------------------------------------------
   UPDATE MEMBER
--------------------------------------------------------- */
async function updateMember() {
    if (!editingMemberId) return;

    const name = document.getElementById("editName").value.trim();
    const contact = document.getElementById("editContact").value.trim();
    const startDate = document.getElementById("editStartDate").value;
    const fee = Number(document.getElementById("editFee").value);

    if (!name) {
        alert("Please enter member name.");
        return;
    }

    if (!startDate) {
        alert("Please select start date.");
        return;
    }

    if (!fee || fee <= 0) {
        alert("Please enter a valid monthly fee.");
        return;
    }

    const updatedMember = {
        id: firebaseMembers.find(m => String(m.id) === String(editingMemberId))?.id || editingMemberId,
        name,
        contact,
        startDate,
        expiryDate: addOneMonth(startDate),
        fee,
        updatedAt: firebase.database.ServerValue.TIMESTAMP
    };

    try {
        await membersRef.child(String(editingMemberId)).update(updatedMember);
        alert("Member updated successfully! ☁️");
        cancelEdit();
    } catch (error) {
        console.error(error);
        alert("Unable to update member in Firebase.\n\n" + error.message);
    }
}

function cancelEdit() {
    editingMemberId = null;
    document.getElementById("editBox").style.display = "none";
}

/* ---------------------------------------------------------
   DELETE MEMBER
--------------------------------------------------------- */
async function deleteMember(id) {
    if (!isAdmin()) {
        alert("Only Admin can delete members.");
        return;
    }

    if (!confirm("Delete this member?\n\nThis will remove the member from Firebase.")) {
        return;
    }

    try {
        await membersRef.child(String(id)).remove();
        alert("Member deleted successfully.");
    } catch (error) {
        console.error(error);
        alert("Unable to delete member from Firebase.\n\n" + error.message);
    }
}

/* ---------------------------------------------------------
   FIREBASE REALTIME LISTENER
--------------------------------------------------------- */
membersRef.on("value", async snapshot => {
    const data = snapshot.val() || {};

    firebaseMembers = Object.keys(data).map(key => ({
        ...data[key],
        id: data[key]?.id ?? key
    }));

    firebaseMembers.sort((a, b) => {
        const aName = String(a.name || "").toLowerCase();
        const bName = String(b.name || "").toLowerCase();
        return aName.localeCompare(bName);
    });

    try {
        await migrateLocalMembersToFirebase(firebaseMembers);
    } catch (error) {
        console.error("Local member migration failed:", error);
    }

    firebaseReady = true;
    syncFirebaseToLocal(firebaseMembers);
    displayMembers();
}, error => {
    console.error("Firebase members listener error:", error);
    firebaseReady = false;

    const table = document.getElementById("membersTableBody");
    if (table) {
        table.innerHTML = `
            <tr>
                <td colspan="8" class="no-results" style="color:#dc2626;">
                    ❌ Firebase error: ${escapeHtml(error.message || "Unable to load members.")}
                </td>
            </tr>
        `;
    }
});

/* ---------------------------------------------------------
   START PAGE
--------------------------------------------------------- */
setStartDate();
updateRoleBanner();
displayMembers();

</script>


