<script>


/* =================================
   FIREBASE
================================= */

const firebaseConfig = {

    apiKey:
        "AIzaSyDGI2ZhwFbhEF40nhC-TxePjP0rNBtDMA",

    authDomain:
        "daily-fitness-8f4bb.firebaseapp.com",

    databaseURL:
        "https://daily-fitness-8f4bb-default-rtdb.firebaseio.com",

    projectId:
        "daily-fitness-8f4bb",

    storageBucket:
        "daily-fitness-8f4bb.firebasestorage.app",

    messagingSenderId:
        "27440670515",

    appId:
        "1:27440670515:web:7292f1ee2573a25fc18046",

    measurementId:
        "G-SBQXSXIDML1"

};


firebase.initializeApp(
    firebaseConfig
);


const db =
    firebase.database();


let members = [];

let payments = [];

let currentUser = null;


/* =================================
   SESSION
================================= */

function getSession(){

    try{

        return JSON.parse(
            localStorage.getItem(
                "dailyFitnessSession"
            )
        ) || null;

    }catch{

        return null;

    }

}


function isAdmin(){

    return (
        currentUser &&
        String(
            currentUser.role
        ).toLowerCase() === "admin"
    );

}


/* =================================
   TODAY
================================= */

function getToday(){

    const d =
        new Date();

    return (

        d.getFullYear() +
        "-" +
        String(
            d.getMonth()+1
        ).padStart(2,"0") +
        "-" +
        String(
            d.getDate()
        ).padStart(2,"0")

    );

}


/* =================================
   MONEY
================================= */

function money(value){

    return "₱" +

        Number(
            value || 0
        ).toLocaleString(
            "en-PH",
            {
                minimumFractionDigits:2,
                maximumFractionDigits:2
            }
        );

}


/* =================================
   ADD ONE MONTH
================================= */

function addOneMonth(
    dateString
){

    const d =
        new Date(
            dateString +
            "T00:00:00"
        );

    const day =
        d.getDate();

    d.setMonth(
        d.getMonth()+1
    );

    if(
        d.getDate() !== day
    ){

        d.setDate(0);

    }

    return (

        d.getFullYear() +
        "-" +
        String(
            d.getMonth()+1
        ).padStart(2,"0") +
        "-" +
        String(
            d.getDate()
        ).padStart(2,"0")

    );

}


/* =================================
   LATER DATE
================================= */

function maxDate(a,b){

    return (
        (a || "") >
        (b || "")
    )
    ?
    (a || b)
    :
    (b || a);

}


/* =================================
   DAYS BETWEEN
================================= */

function daysBetween(a,b){

    const x =
        new Date(
            a +
            "T00:00:00"
        );

    const y =
        new Date(
            b +
            "T00:00:00"
        );

    return Math.round(
        (
            x - y
        ) /
        86400000
    );

}


/* =================================
   ESCAPE HTML
================================= */

function esc(value){

    return String(
        value ?? ""
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}


/* =================================
   LOGOUT
================================= */

function logout(){

    if(
        confirm(
            "Logout from Daily Fitness?"
        )
    ){

        localStorage.removeItem(
            "dailyFitnessSession"
        );

        location.href =
            "login.html";

    }

}


/* =================================
   SETUP USER
================================= */

function setupUser(){

    currentUser =
        getSession();


    if(!currentUser){

        document.getElementById(
            "accessNotice"
        ).textContent =
            "No active session detected. Please log in through the Daily Fitness portal.";

        document.getElementById(
            "saveBtn"
        ).disabled = true;

        return;

    }


    document.getElementById(
        "loggedUser"
    ).textContent =

        currentUser.name ||
        currentUser.username ||
        currentUser.email ||
        "User";


    document.getElementById(
        "roleBadge"
    ).textContent =

        (
            currentUser.role ||
            "STAFF"
        ).toUpperCase();


    if(isAdmin()){

        document.getElementById(
            "accessNotice"
        ).innerHTML =

        "👑 <b style='color:#ffd000'>" +
        "Admin Mode:" +
        "</b> Full payment history and delete access are enabled.";

    }else{

        document.getElementById(
            "accessNotice"
        ).innerHTML =

        "👨‍💼 <b style='color:#ffd000'>" +
        "Staff Mode:" +
        "</b> You can record today's payments. Past/future payment dates are locked.";

    }


    document.getElementById(
        "paymentDate"
    ).value =
        getToday();


    if(!isAdmin()){

        document.getElementById(
            "paymentDate"
        ).disabled = true;

    }

}


/* =================================
   LOAD MEMBERS
================================= */

function loadMembers(){

    db.ref(
        "members"
    ).on(
        "value",
        snapshot => {

            const data =
                snapshot.val() || {};

            members =
                Object.keys(
                    data
                )
                .map(
                    key => ({

                        ...data[key],

                        id:
                            data[key]?.id ??
                            key

                    })
                )
                .sort(
                    (a,b) =>
                        String(
                            a.name || ""
                        )
                        .localeCompare(
                            String(
                                b.name || ""
                            )
                        )
                );


            const select =
                document.getElementById(
                    "paymentMember"
                );


            select.innerHTML =
                '<option value="">' +
                'Select Member' +
                '</option>';


            members.forEach(
                member => {

                    const option =
                        document.createElement(
                            "option"
                        );

                    option.value =
                        member.id;

                    option.textContent =
                        member.name;

                    select.appendChild(
                        option
                    );

                }
            );


            updateMemberPreview();

        }
    );

}


/* =================================
   LOAD PAYMENTS
================================= */

function loadPayments(){

    db.ref(
        "payments"
    ).on(
        "value",
        snapshot => {

            const data =
                snapshot.val() || {};


            payments =
                Object.keys(
                    data
                )
                .map(
                    key => ({

                        ...data[key],

                        id:
                            data[key]?.id ??
                            key

                    })
                );


            renderPayments();

            updateSummary();

        }
    );

}


/* =================================
   SELECT MEMBER
================================= */

function selectedMember(){

    return members.find(
        member =>
            String(
                member.id
            ) ===
            String(
                document.getElementById(
                    "paymentMember"
                ).value
            )
    );

}


/* =================================
   NEW EXPIRY
================================= */

function calculateNewExpiry(
    member
){

    if(!member){

        return "";

    }


    const paymentDate =
        document.getElementById(
            "paymentDate"
        ).value ||
        getToday();


    const base =
        maxDate(
            String(
                member.expiryDate ||
                ""
            ),
            paymentDate
        );


    return addOneMonth(
        base
    );

}


/* =================================
   MEMBER PREVIEW
================================= */

function updateMemberPreview(){

    const member =
        selectedMember();


    const box =
        document.getElementById(
            "memberInfo"
        );


    if(!member){

        box.classList.remove(
            "show"
        );

        return;

    }


    box.classList.add(
        "show"
    );


    document.getElementById(
        "currentExpiry"
    ).textContent =

        member.expiryDate ||
        "-";


    document.getElementById(
        "newExpiry"
    ).textContent =

        calculateNewExpiry(
            member
        );


    const days =
        member.expiryDate
        ?
        daysBetween(
            member.expiryDate,
            getToday()
        )
        :
        null;


    const expiryElement =
        document.getElementById(
            "currentExpiry"
        );


    if(
        days !== null &&
        days < 0
    ){

        expiryElement.className =
            "expiry-bad";

    }else if(

        days !== null &&
        days <= 7

    ){

        expiryElement.className =
            "expiry-warn";

    }else{

        expiryElement.className =
            "expiry-good";

    }

}


/* =================================
   FORM EVENTS
================================= */

document.getElementById(
    "paymentMember"
)
.addEventListener(
    "change",
    updateMemberPreview
);


document.getElementById(
    "paymentDate"
)
.addEventListener(
    "change",
    updateMemberPreview
);


document.getElementById(
    "paymentType"
)
.addEventListener(
    "change",
    updateMemberPreview
);


/* =================================
   SAVE PAYMENT
================================= */

async function savePayment(){

    if(!currentUser){

        alert(
            "Please log in first."
        );

        return;

    }


    const member =
        selectedMember();


    const type =
        document.getElementById(
            "paymentType"
        ).value;


    const amount =
        Number(
            document.getElementById(
                "paymentAmount"
            ).value
        );


    const method =
        document.getElementById(
            "paymentMethod"
        ).value;


    const date =
        document.getElementById(
            "paymentDate"
        ).value ||
        getToday();


    if(!member){

        alert(
            "Please select a member."
        );

        return;

    }


    if(
        !amount ||
        amount <= 0
    ){

        alert(
            "Please enter a valid payment amount."
        );

        return;

    }


    if(
        !isAdmin() &&
        date !== getToday()
    ){

        alert(
            "Staff can only record payments for today."
        );

        document.getElementById(
            "paymentDate"
        ).value =
            getToday();

        return;

    }


    const newExpiry =
        calculateNewExpiry(
            member
        );


    if(!newExpiry){

        alert(
            "Unable to calculate new expiry date."
        );

        return;

    }


    const confirmed =
        confirm(

            "Record " +
            type +
            " payment of " +
            money(amount) +
            " for " +
            member.name +
            "?\n\n" +

            "Current expiry: " +
            (
                member.expiryDate ||
                "-"
            ) +

            "\nNew expiry: " +
            newExpiry

        );


    if(!confirmed){

        return;

    }


    const id =
        Date.now().toString();


    const payment = {

        id:

            id,

        memberId:

            member.id,

        memberName:

            member.name,

        amount:

            amount,

        paymentMethod:

            method,

        paymentType:

            type,

        paymentDate:

            date,

        previousExpiry:

            member.expiryDate ||
            null,

        newExpiry:

            newExpiry,

        recordedBy:

            currentUser.username ||
            currentUser.email ||
            "User",

        recordedByName:

            currentUser.name ||
            currentUser.email ||
            "User",

        createdAt:

            firebase.database
            .ServerValue
            .TIMESTAMP

    };


    /*
        IMPORTANT:

        Payment record +
        member expiry update

        are written together.
    */

    const updates = {};


    updates[
        `payments/${id}`
    ] = payment;


    updates[
        `members/${member.id}/expiryDate`
    ] =
        newExpiry;


    updates[
        `members/${member.id}/updatedAt`
    ] =
        firebase.database
        .ServerValue
        .TIMESTAMP;


    try{

        document.getElementById(
            "saveBtn"
        ).disabled = true;


        await db
            .ref()
            .update(
                updates
            );


        alert(

            "Payment recorded successfully!\n\n" +

            member.name +

            "\nNew expiry: " +

            newExpiry

        );


        document.getElementById(
            "paymentMember"
        ).value = "";


        document.getElementById(
            "paymentAmount"
        ).value = "600";


        document.getElementById(
            "paymentType"
        ).value = "Monthly";


        document.getElementById(
            "paymentMethod"
        ).value = "Cash";


        document.getElementById(
            "paymentDate"
        ).value =
            getToday();


        updateMemberPreview();


    }catch(error){

        console.error(
            error
        );


        alert(

            "Unable to save payment.\n\n" +
            error.message

        );

    }finally{

        document.getElementById(
            "saveBtn"
        ).disabled = false;

    }

}


/* =================================
   RENDER PAYMENTS
================================= */

function renderPayments(){

    const body =
        document.getElementById(
            "paymentsTableBody"
        );


    if(!currentUser){

        body.innerHTML =

            '<tr>' +
            '<td colspan="7" class="empty">' +
            'Please log in.' +
            '</td>' +
            '</tr>';

        return;

    }


    const search =
        document.getElementById(
            "paymentSearch"
        )
        .value
        .trim()
        .toLowerCase();


    const today =
        getToday();


    let visible =
        payments
        .filter(

            payment =>

                isAdmin() ||
                payment.paymentDate ===
                today

        )
        .filter(

            payment =>

                String(
                    payment.memberName ||
                    ""
                )
                .toLowerCase()
                .includes(
                    search
                )

        );


    visible.sort(

        (a,b) =>

            String(
                b.paymentDate ||
                ""
            )
            .localeCompare(
                String(
                    a.paymentDate ||
                    ""
                )
            )

            ||

            (
                Number(
                    b.createdAt
                ) || 0
            )

            -

            (
                Number(
                    a.createdAt
                ) || 0
            )

    );


    if(!visible.length){

        body.innerHTML =

            '<tr>' +

            '<td colspan="7" class="empty">' +

            'No payment records found.' +

            '</td>' +

            '</tr>';

        return;

    }


    body.innerHTML =

        visible
        .map(

            payment => `

                <tr>

                    <td>
                        ${esc(
                            payment.paymentDate ||
                            "-"
                        )}
                    </td>

                    <td>
                        <b>
                            ${esc(
                                payment.memberName ||
                                "-"
                            )}
                        </b>
                    </td>

                    <td
                        class="type ${
                            payment.paymentType ===
                            "Renewal"
                            ?
                            "type-renewal"
                            :
                            "type-monthly"
                        }"
                    >

                        ${esc(
                            payment.paymentType ||
                            "Monthly"
                        )}

                    </td>

                    <td class="amount">

                        ${money(
                            payment.amount
                        )}

                    </td>

                    <td
                        class="${
                            payment.paymentMethod ===
                            "Cash"
                            ?
                            "method-cash"
                            :
                            "method-gcash"
                        }"
                    >

                        ${esc(
                            payment.paymentMethod ||
                            "-"
                        )}

                    </td>

                    <td>

                        ${esc(
                            payment.recordedByName ||
                            payment.recordedBy ||
                            "-"
                        )}

                    </td>

                    <td>

                        ${
                            isAdmin()

                            ?

                            `
                            <button
                                class="delete"
                                onclick="deletePayment('${esc(payment.id)}')"
                            >
                                Delete
                            </button>
                            `

                            :

                            `
                            <span class="locked">
                                🔒 Staff
                            </span>
                            `
                        }

                    </td>

                </tr>

            `

        )
        .join("");

}


/* =================================
   SUMMARY
================================= */

function updateSummary(){

    const today =
        getToday();


    const todayPayments =
        payments.filter(

            payment =>
                payment.paymentDate ===
                today

        );


    let sales = 0;

    let cash = 0;

    let gcash = 0;


    todayPayments.forEach(

        payment => {

            const amount =
                Number(
                    payment.amount
                ) || 0;


            sales += amount;


            if(
                payment.paymentMethod ===
                "Cash"
            ){

                cash += amount;

            }


            if(
                payment.paymentMethod ===
                "GCash"
            ){

                gcash += amount;

            }

        }

    );


    document.getElementById(
        "totalSales"
    ).textContent =
        money(sales);


    document.getElementById(
        "totalCash"
    ).textContent =
        money(cash);


    document.getElementById(
        "totalGcash"
    ).textContent =
        money(gcash);

}


/* =================================
   DELETE PAYMENT
================================= */

async function deletePayment(id){

    if(!isAdmin()){

        alert(
            "Only Admin can delete payment records."
        );

        return;

    }


    const confirmed =
        confirm(

            "Delete this payment record?\n\n" +

            "This will NOT automatically reverse " +
            "the member expiry."

        );


    if(!confirmed){

        return;

    }


    try{

        await db
            .ref(
                "payments"
            )
            .child(
                String(id)
            )
            .remove();


        alert(
            "Payment deleted successfully."
        );


    }catch(error){

        alert(

            "Unable to delete payment.\n\n" +
            error.message

        );

    }

}


